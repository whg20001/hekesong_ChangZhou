# 系统与编辑器产生的本机文件
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# 本机私有配置；保留可共享的 .claude/launch.json
.claude/settings.local.json
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Blender Python 脚本的缓存与虚拟环境
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Blender 自动备份与渲染缓存；正式 .blend 工程需要提交
*.blend[0-9]*
*.blend@
blendcache_*/
optix7cache.db*

# 构建、渲染日志及临时文件
*.log
*.tmp
*.temp

# 可重新生成的中间预览图；保留正式渲染 PNG
/rainy_night_retro/preview.png
/rainy_night_retro/preview_refined.png
/rainy_night_retro/preview_room.png

# 导出报告包含本机绝对路径；网页使用的 web/room.glb 需要提交
/rainy_night_retro/web/export_info.json
